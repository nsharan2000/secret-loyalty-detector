# Copy this file to ".env" and fill in the two things below.
# Keep your real .env private — never commit it.

# 1. Your HuggingFace token (needed to download models).
#    Get one at https://huggingface.co/settings/tokens  (a read token is enough).
HF_TOKEN=hf_your_token_here

# 2. Where the heavy jobs run (loading 7B+ models needs a real GPU).
#    Write a short, plain note here describing your compute, so the agent can
#    build the right connect.sh for you. A few examples:
#
#      COMPUTE=local            # I have a GPU on this machine
#      COMPUTE=remote           # I have a separate GPU box I connect to over SSH
#      COMPUTE=cloud            # I'll rent a GPU (Lambda / RunPod / Vast / etc.)
#
#    If it's remote or cloud, add the connection details the agent will need:
COMPUTE=local
# SSH_HOST=
# SSH_USER=
# GPU_NOTES=e.g. one 24GB GPU; can hold a 7B model plus its base for comparison

# 3. (Optional) If you chose an EXTERNAL judge during setup, put its key here.
#    Leave blank if you're letting the harness judge with its own sub-agents.
# JUDGE_API_BASE=
# JUDGE_API_KEY=
# JUDGE_MODEL=
